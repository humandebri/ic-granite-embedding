type EmbeddingStep = record {
  instructions : nat64;
  state : blob;
  tokens : nat32;
  embedding : vec float32;
  next_layer : nat32;
};
type Measurement = record { data : blob; instructions : nat64 };
type Result = variant { Ok; Err : text };
type Result_1 = variant { Ok : EmbeddingStep; Err : text };
type Result_2 = variant { Ok : Measurement; Err : text };
service : {
  activate : () -> (Result);
  continueEmbedding : (nat32, nat32, blob) -> (Result_1) query;
  startEmbedding : (vec nat32) -> (Result_1) query;
  step : (blob) -> (Result_2) query;
  upload : (nat64, blob) -> ();
}
